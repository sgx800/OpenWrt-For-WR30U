# SPDX-License-Identifier: MIT
# MT7981 chip settings: Yuzhii0718/CloseWRT-CI-VIKINGYFY e9b9f9c.
# Only the WR30U STOCK partition layout is enabled; never use for ubootmod.
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
# CONFIG_TARGET_ALL_PROFILES is not set
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_xiaomi_mi-router-wr30u-stock=y
# Keep this Kconfig string on ONE line. Remove device-default mt76 packages
# from the image without editing filogic.mk or the device tree.
CONFIG_TARGET_DEVICE_PACKAGES_mediatek_filogic_DEVICE_xiaomi_mi-router-wr30u-stock="-kmod-mt7915e -kmod-mt7981-firmware -mt7981-wo-firmware"
# CONFIG_PACKAGE_kmod-mt7915e is not set
# CONFIG_PACKAGE_kmod-mt7981-firmware is not set
# CONFIG_PACKAGE_mt7981-wo-firmware is not set
# CONFIG_PACKAGE_kmod-mt_wifi7 is not set
# CONFIG_PACKAGE_kmod-mt_hwifi is not set
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_CCACHE=y
CONFIG_DEVEL=y
CONFIG_first_card_name="MT7981"
CONFIG_MTK_CHIP_MT7981=y
CONFIG_MTK_CONNINFRA_APSOC_MT7981=y
CONFIG_MTK_FIRST_IF_MT7981=y
CONFIG_MTK_MT7981_NEW_FW=y
CONFIG_WARP_CHIPSET="mt7981"
