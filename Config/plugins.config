# Personal application choices. Native feed/driver dependencies are retained.
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-app-homeproxy=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-wechatpush=y
CONFIG_PACKAGE_luci-app-tailscale=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-wolplus=y
CONFIG_PACKAGE_luci-theme-aurora=y
CONFIG_PACKAGE_luci-app-aurora-config=y
# Explicitly retain LuCI web terminal; TurboACC-mtk also depends on it.
CONFIG_PACKAGE_luci-app-ttyd=y
# Restore the three controls for the MTK Vendor stack.
CONFIG_PACKAGE_luci-app-mtwifi-cfg=y
CONFIG_PACKAGE_luci-app-turboacc-mtk=y
CONFIG_PACKAGE_luci-app-eqos-mtk=y
# Previously unwanted applications remain disabled.
# CONFIG_PACKAGE_luci-app-netspeedtest is not set
# CONFIG_PACKAGE_luci-app-attendedsysupgrade is not set
# CONFIG_PACKAGE_luci-app-wol is not set
# CONFIG_PACKAGE_luci-app-wolultra is not set
# CONFIG_PACKAGE_luci-app-owq-wol is not set
# CONFIG_PACKAGE_luci-app-gecoosac is not set
# CONFIG_PACKAGE_luci-app-samba4 is not set
# CONFIG_PACKAGE_luci-app-partexp is not set
# CONFIG_PACKAGE_luci-app-mini-diskmanager is not set
# CONFIG_PACKAGE_luci-app-natmapt is not set
